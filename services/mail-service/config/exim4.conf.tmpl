######################################################################
# Viswall mail-service Exim4 config (Postgres domains, Dovecot SASL/LMTP)
######################################################################

primary_hostname = @@PRIMARY_HOSTNAME@@
qualify_domain   = @@PRIMARY_HOSTNAME@@

hide pgsql_servers = @@PG_SERVERS@@

domainlist local_domains    = pgsql;SELECT domain FROM mail_domains WHERE lower(domain)=lower('${quote_pgsql:$domain}') AND enabled=TRUE
domainlist relay_to_domains =
hostlist   relay_from_hosts = 127.0.0.1 : ::1

acl_smtp_rcpt = acl_check_rcpt
acl_smtp_data = acl_check_data

av_scanner    = clamd:/var/run/clamav/clamd.ctl
spamd_address = 127.0.0.1 783

tls_advertise_hosts  = *
tls_certificate      = /etc/exim4/tls.crt
tls_privatekey       = /etc/exim4/tls.key
daemon_smtp_ports    = 25 : 465 : 587
tls_on_connect_ports = 465

# Advertise AUTH only on encrypted sessions
auth_advertise_hosts = ${if def:tls_in_cipher {*}{}}

never_users        = root
message_size_limit = 50M
host_lookup        = *
rfc1413_hosts      = :
keep_environment =

begin acl

acl_check_rcpt:
  accept  hosts = :
          control = dkim_disable_verify

  deny    message     = Restricted characters in address
          domains     = +local_domains
          local_parts = ^[.] : ^.*[@%!/|]

  accept  local_parts = postmaster
          domains     = +local_domains

  accept  authenticated = *
          control       = submission/sender_retain

  accept  hosts   = +relay_from_hosts
          control = submission/sender_retain

  require verify = sender

  require message = relay not permitted
          domains = +local_domains : +relay_to_domains

  require verify = recipient

  accept

acl_check_data:
  deny    message = This message contains malware ($malware_name)
          malware = *

  warn    spam = nobody:true
          add_header = X-Spam-Score: $spam_score
          add_header = X-Spam-Report: $spam_report

  warn    condition  = ${if >{$spam_score_int}{50}{yes}{no}}
          add_header = X-Spam-Flag: YES

  accept

begin routers

# 0) Address is a real mailbox AND has alias rows -> copy to the extra destinations
#    (unseen) while the message still continues to the mailbox for local delivery.
alias_copy:
  driver = redirect
  domains = +local_domains
  condition = ${if and{{eq{${lookup pgsql{SELECT 1 FROM mail_users u JOIN mail_domains d ON u.domain_id=d.id WHERE lower(u.username)=lower('${quote_pgsql:$local_part}') AND lower(d.domain)=lower('${quote_pgsql:$domain}') AND u.enabled=TRUE}{true}{false}}}{true}}{eq{${lookup pgsql{SELECT 1 FROM mail_aliases a JOIN mail_domains d ON a.domain_id=d.id WHERE lower(d.domain)=lower('${quote_pgsql:$domain}') AND lower(a.source)=lower('${quote_pgsql:$local_part}') AND a.enabled=TRUE LIMIT 1}{true}{false}}}{true}}}{yes}{no}}
  data = ${lookup pgsql{SELECT string_agg(a.destination, chr(10)) FROM mail_aliases a JOIN mail_domains d ON a.domain_id=d.id WHERE lower(d.domain)=lower('${quote_pgsql:$domain}') AND lower(a.source)=lower('${quote_pgsql:$local_part}') AND a.enabled=TRUE}{$value}{}}
  unseen
  no_verify

# 1) Pure alias (no mailbox for this local_part) -> full redirect to destination(s)
alias_redirect:
  driver = redirect
  domains = +local_domains
  condition = ${if and{{!eq{${lookup pgsql{SELECT 1 FROM mail_users u JOIN mail_domains d ON u.domain_id=d.id WHERE lower(u.username)=lower('${quote_pgsql:$local_part}') AND lower(d.domain)=lower('${quote_pgsql:$domain}') AND u.enabled=TRUE}{true}{false}}}{true}}{eq{${lookup pgsql{SELECT 1 FROM mail_aliases a JOIN mail_domains d ON a.domain_id=d.id WHERE lower(d.domain)=lower('${quote_pgsql:$domain}') AND lower(a.source)=lower('${quote_pgsql:$local_part}') AND a.enabled=TRUE LIMIT 1}{true}{false}}}{true}}}{yes}{no}}
  data = ${lookup pgsql{SELECT string_agg(a.destination, chr(10)) FROM mail_aliases a JOIN mail_domains d ON a.domain_id=d.id WHERE lower(d.domain)=lower('${quote_pgsql:$domain}') AND lower(a.source)=lower('${quote_pgsql:$local_part}') AND a.enabled=TRUE}{$value}{}}

# 3) Local mailbox delivery via Dovecot LMTP
virtual_mailbox:
  driver = accept
  domains = +local_domains
  condition = ${lookup pgsql{SELECT 1 FROM mail_users u JOIN mail_domains d ON u.domain_id=d.id WHERE lower(u.username)=lower('${quote_pgsql:$local_part}') AND lower(d.domain)=lower('${quote_pgsql:$domain}') AND u.enabled=TRUE}{true}{false}}
  transport = dovecot_lmtp

# 4) Domain catch-all (no mailbox, no exact alias)
catchall:
  driver = redirect
  domains = +local_domains
  condition = ${if and{{!eq{${lookup pgsql{SELECT 1 FROM mail_users u JOIN mail_domains d ON u.domain_id=d.id WHERE lower(u.username)=lower('${quote_pgsql:$local_part}') AND lower(d.domain)=lower('${quote_pgsql:$domain}') AND u.enabled=TRUE}{true}{false}}}{true}}{!eq{${lookup pgsql{SELECT 1 FROM mail_aliases a JOIN mail_domains d ON a.domain_id=d.id WHERE lower(d.domain)=lower('${quote_pgsql:$domain}') AND lower(a.source)=lower('${quote_pgsql:$local_part}') AND a.enabled=TRUE LIMIT 1}{true}{false}}}{true}}}{yes}{no}}
  data = ${lookup pgsql{SELECT string_agg(a.destination, chr(10)) FROM mail_aliases a JOIN mail_domains d ON a.domain_id=d.id WHERE lower(d.domain)=lower('${quote_pgsql:$domain}') AND a.source='*' AND a.enabled=TRUE}{$value}{}}

# 5) Remote delivery
dnslookup:
  driver = dnslookup
  domains = ! +local_domains
  transport = remote_smtp
  ignore_target_hosts = 0.0.0.0 : 127.0.0.0/8

begin transports

dovecot_lmtp:
  driver = lmtp
  socket = /var/run/dovecot/lmtp
  batch_max = 20

remote_smtp:
  driver = smtp
  helo_data = @@PRIMARY_HOSTNAME@@
  dkim_domain = ${if eq{$sender_address_domain}{@@DKIM_DOMAIN@@}{@@DKIM_DOMAIN@@}{}}
  dkim_selector = viswall
  dkim_private_key = /etc/exim4/dkim/viswall.private
  dkim_canon = relaxed
  dkim_strict = false

begin retry
*   *   F,2h,15m; G,16h,1h,1.5; F,4d,6h

begin rewrite

begin authenticators

dovecot_plain:
  driver = dovecot
  public_name = PLAIN
  server_socket = /var/run/dovecot/auth-exim
  server_set_id = $auth1

dovecot_login:
  driver = dovecot
  public_name = LOGIN
  server_socket = /var/run/dovecot/auth-exim
  server_set_id = $auth1
