# Database
DB_PASSWORD=viswall_secure_password

# JWT Secret (change in production!)
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# CORS Origins (must match nginx HTTPS endpoint)
CORS_ORIGINS=https://localhost

# Grafana Admin Password
GRAFANA_PASSWORD=admin

# nginx / TLS Configuration
# SSL_MODE: "selfsigned" (dev) or "letsencrypt" (production)
SSL_MODE=selfsigned
DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@example.com

# Groupware (SOGo)
# SOGo timezone (e.g., UTC, America/New_York, Europe/Berlin)
TZ=UTC

# Ollama LLM
OLLAMA_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:9b

# IPv6 Configuration
# ULA subnet for the Docker bridge network. Set to empty to disable IPv6.
IPV6_SUBNET=fd00:42::/64

# Metrics collection (api-gateway background collector)
# METRICS_COLLECTOR_ENABLED=true
# METRICS_INTERVAL=60
# Snapshots older than this many days are pruned; 0 disables pruning.
# METRICS_RETENTION_DAYS=30

# Image tag used with docker-compose.prod.yml (GHCR pull deployment).
# Set automatically by scripts/deploy.sh; "main" tracks the latest main build.
# VISWALL_TAG=main

# Instance API Keys (for connecting agents to api-gateway)
# INSTANCE_API_KEY=vis_xxxxxxxxxxxxxxxx

# Node agent (host interface management) — enable by setting both values.
# Create the instance in the UI, reveal its API key (Instance detail page),
# and set NODE_INSTANCE_ID to that instance's numeric ID. The control API
# listens on host port 8085; publish nothing extra (host networking).
# NODE_INSTANCE_ID=1
# NODE_API_KEY=vis_xxxxxxxxxxxxxxxx
# NODE_GATEWAY_URL=http://127.0.0.1:8010

# Service Agent Settings (uncomment in docker-compose.yml to enable)
# FIREWALL_AGENT_PORT=8081
# VPN_AGENT_PORT=8082

# Mail Service (optional — only needed with --profile mail)
MAIL_HOSTNAME=mail.example.com
LETSENCRYPT_LIVE=/etc/letsencrypt/live/mail.example.com

# DNS agent publish binding (staging used 5353; production 53)
DNS_PUBLISH_ADDR=46.4.63.216
DNS_PUBLISH_PORT=53

# Post-deploy regression suite (scripts/deploy.sh runs tests/post_deploy/
# smoke.py after every deploy and rolls back on failure; skipped when unset).
# Create a dedicated user (see tests/post_deploy/README.md); value on its own
# line, unquoted.
# SMOKE_USERNAME=viswall-smoke
# SMOKE_PASSWORD=change-me-long-random
